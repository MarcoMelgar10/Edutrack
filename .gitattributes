# Store and check out text files with LF endings on every platform (Java, Maven and Git Bash are fine with LF).
* text=auto eol=lf

# Windows batch files need CRLF to run reliably.
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binary assets.
*.png binary
*.ttf binary
*.jar binary

# Translation bundles only grow by appended keys: merge parallel additions by keeping both sides.
*.properties merge=union
