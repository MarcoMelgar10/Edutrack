<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.session.LogSessionDialogController"
      styleClass="form" spacing="16" prefWidth="480">

    <VBox styleClass="form-field" spacing="6">
        <Label text="%session.form.goal" styleClass="form-label"/>
        <ComboBox fx:id="goalBox" promptText="%session.form.goalPrompt" maxWidth="Infinity"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%session.form.step" styleClass="form-label"/>
        <ComboBox fx:id="stepBox" maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="16">
        <VBox styleClass="form-field" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%form.date" styleClass="form-label"/>
            <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="form-field" spacing="6">
            <Label text="%session.form.start" styleClass="form-label"/>
            <TextField fx:id="timeField" promptText="%session.form.startPrompt" prefColumnCount="6"/>
        </VBox>
        <VBox styleClass="form-field" spacing="6">
            <Label text="%session.form.minutes" styleClass="form-label"/>
            <TextField fx:id="minutesField" promptText="%session.form.minutesPrompt" prefColumnCount="6"/>
        </VBox>
    </HBox>

    <Label fx:id="hintLabel" styleClass="form-hint" wrapText="true"/>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.note" styleClass="form-label"/>
        <TextArea fx:id="noteField" promptText="%form.optional" prefRowCount="2" wrapText="true"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
</VBox>
