<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.dialog.GoalDialogController"
      styleClass="form" spacing="16" prefWidth="460">

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.title" styleClass="form-label"/>
        <TextField fx:id="titleField" promptText="%dialog.goal.titlePrompt"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.description" styleClass="form-label"/>
        <TextArea fx:id="descriptionField" promptText="%form.optional" prefRowCount="3" wrapText="true"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.deadline" styleClass="form-label"/>
        <DatePicker fx:id="deadlinePicker" promptText="%dialog.goal.deadlinePrompt" maxWidth="Infinity"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%dialog.goal.weekly" styleClass="form-label"/>
        <TextField fx:id="weeklyField" promptText="%dialog.goal.weeklyPrompt"/>
        <Label text="%dialog.goal.weeklyHelp" styleClass="form-hint" wrapText="true"/>
        <Label fx:id="weeklyHint" text="%dialog.goal.weeklyInvalid" styleClass="form-error" wrapText="true"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
</VBox>
