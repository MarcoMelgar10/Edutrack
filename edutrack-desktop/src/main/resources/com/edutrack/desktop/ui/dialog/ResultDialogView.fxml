<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.dialog.ResultDialogController"
      styleClass="form" spacing="16" prefWidth="460">

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.title" styleClass="form-label"/>
        <TextField fx:id="titleField" promptText="%dialog.result.titlePrompt"/>
    </VBox>

    <HBox fx:id="measureGroup" spacing="16">
        <VBox styleClass="form-field" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%dialog.result.measure" styleClass="form-label"/>
            <ComboBox fx:id="measureBox" maxWidth="Infinity"/>
        </VBox>
        <VBox fx:id="partGroup" styleClass="form-field" spacing="6">
            <Label text="%dialog.result.part" styleClass="form-label"/>
            <TextField fx:id="partField" promptText="%dialog.result.partPrompt" prefColumnCount="10"/>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="form-field" spacing="6">
            <Label text="%form.score" styleClass="form-label"/>
            <TextField fx:id="scoreField" promptText="%dialog.result.scorePrompt" prefColumnCount="8"/>
        </VBox>
        <VBox styleClass="form-field" spacing="6">
            <Label text="%form.outOf" styleClass="form-label"/>
            <TextField fx:id="maxScoreField" promptText="%dialog.result.maxPrompt" prefColumnCount="8"/>
        </VBox>
    </HBox>

    <Label fx:id="scoreHint" styleClass="form-hint" wrapText="true"/>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.date" styleClass="form-label"/>
        <DatePicker fx:id="datePicker" promptText="%dialog.result.datePrompt" maxWidth="Infinity"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.note" styleClass="form-label"/>
        <TextArea fx:id="noteField" promptText="%dialog.result.notePrompt" prefRowCount="2" wrapText="true"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
</VBox>
