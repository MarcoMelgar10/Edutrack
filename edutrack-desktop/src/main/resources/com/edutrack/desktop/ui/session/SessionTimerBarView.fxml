<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- The study-session bar: docked at the bottom of the window while a session is being timed. -->
<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" fx:controller="com.edutrack.desktop.ui.session.SessionTimerBarController"
      styleClass="session-bar" alignment="CENTER_LEFT" spacing="14">
    <padding>
        <Insets top="10" right="28" bottom="10" left="28"/>
    </padding>

    <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
        <Hyperlink fx:id="titleLink" styleClass="session-bar-title" textOverrun="ELLIPSIS" maxWidth="Infinity"
                   onAction="#openTarget"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="phaseLabel" styleClass="session-bar-phase"/>
            <Label fx:id="remainingLabel" styleClass="text-caption"/>
        </HBox>
        <Label fx:id="noticeLabel" styleClass="session-bar-notice" wrapText="true"/>
    </VBox>

    <Label fx:id="elapsedLabel" styleClass="session-elapsed"/>

    <Button fx:id="pauseButton" minWidth="-Infinity" onAction="#togglePause"/>
    <Button fx:id="stopButton" text="%session.stopAndSave" styleClass="accent" minWidth="-Infinity"
            onAction="#stop"/>
    <Button fx:id="discardButton" styleClass="icon-button" onAction="#discard"/>
</HBox>
