<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.dialog.ExerciseDialogController"
      styleClass="form" spacing="16" prefWidth="460">

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.title" styleClass="form-label"/>
        <TextField fx:id="titleField" promptText="%dialog.exercise.titlePrompt"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
</VBox>
