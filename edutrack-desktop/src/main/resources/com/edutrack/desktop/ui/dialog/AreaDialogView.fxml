<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.dialog.AreaDialogController"
      styleClass="form" spacing="16" prefWidth="460">

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.name" styleClass="form-label"/>
        <TextField fx:id="nameField" promptText="%dialog.area.namePrompt"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.description" styleClass="form-label"/>
        <TextArea fx:id="descriptionField" promptText="%form.optional" prefRowCount="3" wrapText="true"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.icon" styleClass="form-label"/>
        <!-- 32 icons wrap into rows of eight (8 x 36 px + gaps fits the 460 px dialog). -->
        <TilePane fx:id="iconPicker" styleClass="icon-picker" hgap="6" vgap="6" prefColumns="8"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
</VBox>
