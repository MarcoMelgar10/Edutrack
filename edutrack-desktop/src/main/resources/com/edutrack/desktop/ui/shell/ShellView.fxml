<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- The window: a fixed left rail and, to its right, the page that is showing plus a dock for the session bar. -->
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="root" fx:controller="com.edutrack.desktop.ui.shell.ShellController"
            styleClass="shell">
    <left>
        <VBox fx:id="rail" styleClass="shell-rail">
            <HBox fx:id="brand" styleClass="shell-brand" alignment="CENTER_LEFT" spacing="8">
                <!-- Folds the rail down to this button; the icon and tooltip are set in code. -->
                <Button fx:id="sidebarToggle" styleClass="icon-button" onAction="#toggleSidebar"/>
                <Label fx:id="appTitle" text="%app.name" styleClass="app-title"/>
            </HBox>

            <!-- One entry per page; built in code from ShellPage. -->
            <VBox fx:id="navBox" styleClass="shell-nav" spacing="2"/>

            <HBox fx:id="areasHeader" styleClass="shell-section" alignment="CENTER_LEFT">
                <Label text="%shell.areas" styleClass="section-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="newAreaButton" styleClass="icon-button" onAction="#onNewArea"
                        accessibleText="%shell.newArea">
                    <tooltip>
                        <Tooltip text="%shell.newArea"/>
                    </tooltip>
                </Button>
            </HBox>

            <ListView fx:id="areaList" styleClass="area-rail" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="%shell.areas.empty" styleClass="text-caption"/>
                </placeholder>
            </ListView>

            <!-- Settings and the theme switch; filled in code. -->
            <HBox fx:id="footer" styleClass="shell-footer" alignment="CENTER_LEFT" spacing="4"/>
        </VBox>
    </left>

    <center>
        <StackPane>
            <VBox>
                <StackPane fx:id="content" styleClass="shell-content" VBox.vgrow="ALWAYS"/>
                <!-- A later version docks the study-session bar here; hidden while empty. -->
                <StackPane fx:id="dock" styleClass="shell-dock"/>
            </VBox>
            <!-- The only chrome left in focus mode. -->
            <Button fx:id="exitFocusButton" styleClass="focus-exit" onAction="#exitFocus"
                    StackPane.alignment="TOP_RIGHT">
                <StackPane.margin>
                    <Insets top="6" right="10"/>
                </StackPane.margin>
            </Button>
        </StackPane>
    </center>
</BorderPane>
