<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.cards.CardImportController"
      styleClass="form" spacing="14" prefWidth="560">

    <Label text="%cards.import.explanation" styleClass="form-hint" wrapText="true"/>

    <VBox styleClass="form-field" spacing="6">
        <HBox alignment="CENTER_LEFT">
            <Label text="%cards.import.text" styleClass="form-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%cards.import.chooseFile" styleClass="flat" onAction="#chooseFile"/>
        </HBox>
        <TextArea fx:id="textArea" styleClass="monospace" prefRowCount="10" wrapText="false"
                  promptText="%cards.import.prompt"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%cards.step" styleClass="form-label"/>
        <ComboBox fx:id="stepBox" maxWidth="Infinity"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
</VBox>
