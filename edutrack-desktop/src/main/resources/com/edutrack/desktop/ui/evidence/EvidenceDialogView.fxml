<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.evidence.EvidenceDialogController"
      styleClass="form" spacing="16" prefWidth="500">

    <HBox spacing="16">
        <VBox styleClass="form-field" spacing="6">
            <Label text="%evidence.form.kind" styleClass="form-label"/>
            <ComboBox fx:id="kindBox" prefWidth="170"/>
        </VBox>
        <VBox styleClass="form-field" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%form.title" styleClass="form-label"/>
            <TextField fx:id="titleField" promptText="%evidence.form.titlePrompt"/>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="form-field" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%form.date" styleClass="form-label"/>
            <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="form-field" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="%evidence.form.step" styleClass="form-label"/>
            <ComboBox fx:id="stepBox" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%evidence.form.link" styleClass="form-label"/>
        <TextField fx:id="urlField" promptText="%evidence.form.linkPrompt"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%evidence.form.file" styleClass="form-label"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="%evidence.file.choose" onAction="#chooseFile"/>
            <Label fx:id="fileLabel" styleClass="text-caption" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="removeFileButton" text="%evidence.file.remove" styleClass="flat" onAction="#removeFile"/>
        </HBox>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%evidence.form.competency" styleClass="form-label"/>
        <ComboBox fx:id="competencyBox" maxWidth="Infinity"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.note" styleClass="form-label"/>
        <TextArea fx:id="noteField" promptText="%form.optional" prefRowCount="2" wrapText="true"/>
        <Label text="%evidence.form.hint" styleClass="form-hint" wrapText="true"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
</VBox>
