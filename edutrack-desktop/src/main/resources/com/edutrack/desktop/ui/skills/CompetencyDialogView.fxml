<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.skills.CompetencyDialogController"
      styleClass="form" spacing="16" prefWidth="460">

    <VBox styleClass="form-field" spacing="6">
        <Label text="%competency.form.name" styleClass="form-label"/>
        <TextField fx:id="nameField" promptText="%competency.form.namePrompt"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%form.description" styleClass="form-label"/>
        <TextArea fx:id="descriptionField" promptText="%form.optional" prefRowCount="2" wrapText="true"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%competency.form.target" styleClass="form-label"/>
        <ComboBox fx:id="targetBox" maxWidth="Infinity"/>
        <Label text="%competency.form.targetHelp" styleClass="form-hint" wrapText="true"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
</VBox>
