<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.edutrack.desktop.ui.session.StartSessionDialogController"
      styleClass="form" spacing="16" prefWidth="460">

    <VBox styleClass="form-field" spacing="6">
        <Label text="%session.form.goal" styleClass="form-label"/>
        <ComboBox fx:id="goalBox" promptText="%session.form.goalPrompt" maxWidth="Infinity"/>
    </VBox>

    <VBox styleClass="form-field" spacing="6">
        <Label text="%session.form.step" styleClass="form-label"/>
        <ComboBox fx:id="stepBox" maxWidth="Infinity"/>
    </VBox>

    <CheckBox fx:id="pomodoroCheck" text="%session.form.pomodoro"/>
</VBox>
